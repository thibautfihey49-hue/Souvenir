<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/surface_card"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/titre_contact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Contact"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <ImageButton
            android:id="@+id/btn_appel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_cercle"
            android:src="@drawable/ic_call"
            android:tint="@color/primary"
            android:contentDescription="Appel"/>

        <ImageButton
            android:id="@+id/btn_visio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_cercle"
            android:src="@drawable/ic_video"
            android:tint="@color/primary"
            android:contentDescription="Appel vidéo"/>
    </LinearLayout>

    <!-- Liste des messages -->
    <ListView
        android:id="@+id/liste_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:background="@color/surface"/>

    <!-- Zone Enregistrement Vocal -->
    <LinearLayout
        android:id="@+id/zone_enregistrement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFF3CD"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎤 Enregistrement en cours..."
            android:textSize="15sp"
            android:textColor="#856404"/>

        <TextView
            android:id="@+id/chrono_enregistrement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#856404"
            android:layout_marginHorizontal="12dp"/>

        <ImageButton
            android:id="@+id/btn_stop_enregistrement"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_cercle_rouge"
            android:src="@drawable/ic_stop"
            android:tint="#FFFFFF"
            android:contentDescription="Arrêter et envoyer"/>
    </LinearLayout>

    <!-- Clavier Emojis -->
    <LinearLayout
        android:id="@+id/clavier_emojis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@color/surface_card"
        android:visibility="gone">
        <GridView
            android:id="@+id/grid_emojis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:numColumns="8"/>
    </LinearLayout>

    <!-- Zone de saisie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/surface_card"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_vocal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_cercle"
            android:src="@drawable/ic_mic"
            android:tint="@color/primary"
            android:contentDescription="Message vocal"/>

        <ImageButton
            android:id="@+id/btn_photo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cercle"
            android:src="@drawable/ic_image"
            android:tint="@color/primary"
            android:contentDescription="Photo/MMS"/>

        <ImageButton
            android:id="@+id/btn_emoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cercle"
            android:src="@drawable/ic_emoji"
            android:tint="@color/primary"
            android:contentDescription="Emojis"/>

        <EditText
            android:id="@+id/champ_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:hint="Écrire un message..."
            android:background="@drawable/saisie_fond"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:maxLines="4"/>

        <ImageButton
            android:id="@+id/btn_envoyer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_cercle_primary"
            android:src="@drawable/ic_send_white"
            android:tint="#FFFFFF"
            android:contentDescription="Envoyer"/>
    </LinearLayout>
</LinearLayout>
