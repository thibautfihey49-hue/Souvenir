<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:onClick="finish"
            android:contentDescription="Retour"/>

        <TextView
            android:id="@+id/titre_contact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:textColor="#202124"/>

        <!-- 📞 Appel vocal -->
        <ImageButton
            android:id="@+id/btn_appel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_call"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Appel vocal"/>

        <!-- 📹 Appel visio -->
        <ImageButton
            android:id="@+id/btn_visio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Appel vidéo"/>
    </LinearLayout>

    <!-- Liste des messages -->
    <ListView
        android:id="@+id/liste_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:divider="@null"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll"/>

    <!-- 😀 Clavier émoticônes -->
    <LinearLayout
        android:id="@+id/clavier_emojis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:padding="8dp">

        <GridView
            android:id="@+id/grid_emojis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:numColumns="8"
            android:horizontalSpacing="4dp"
            android:verticalSpacing="4dp"/>
    </LinearLayout>

    <!-- 📷 Aperçu photo avant envoi -->
    <LinearLayout
        android:id="@+id/apercu_photo_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:visibility="gone">
    </LinearLayout>

    <!-- Barre de saisie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <!-- 😀 Bouton émojis -->
        <ImageButton
            android:id="@+id/btn_emoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Émoticônes"/>

        <!-- 📷 Bouton photo/MMS -->
        <ImageButton
            android:id="@+id/btn_photo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Joindre une photo"/>

        <!-- Champ message -->
        <EditText
            android:id="@+id/champ_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Écrivez votre message..."
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="44dp"
            android:maxLines="4"
            android:padding="12dp"
            android:background="@drawable/saisie_fond"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- ➤ Envoyer -->
        <ImageButton
            android:id="@+id/btn_envoyer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/fab_background"
            android:tint="#FFFFFF"
            android:contentDescription="Envoyer"/>
    </LinearLayout>

</LinearLayout>
