<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <!-- ✅ UN SEUL ENFANT DIRECT : LinearLayout principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barre supérieure -->
        <LinearLayout
            android:id="@+id/barre_haut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#FFFFFF"
            android:elevation="2dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Messages"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#202124"/>
                <TextView
                    android:id="@+id/badge_cache"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="0"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="@drawable/badge_cercle"
                    android:visibility="gone"/>
            </LinearLayout>

            <EditText
                android:id="@+id/champ_recherche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rechercher des conversations ou contacts"
                android:background="@drawable/saisie_fond"
                android:padding="10dp"
                android:layout_marginHorizontal="8dp"/>
        </LinearLayout>

        <!-- 📞 ESPACE CRÉER UN CONTACT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Créer un Contact"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:paddingLeft="16dp"
            android:paddingTop="20dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginHorizontal="16dp"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/nouveau_contact_nom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nom du contact"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:background="@drawable/saisie_fond"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/nouveau_contact_numero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Numéro de téléphone"
                android:inputType="phone"
                android:padding="12dp"
                android:background="@drawable/saisie_fond"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_enregistrer_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Enregistrer et démarrer la conversation"
                android:backgroundTint="#1B66F5"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- 👤 MES CONTACTS -->
        <TextView
            android:id="@+id/titre_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Mes Contacts"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/liste_contacts_vide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aucun contact enregistré"
                android:textSize="14sp"
                android:textColor="#80868B"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→ Utilisez le formulaire ci-dessus"
                android:textSize="13sp"
                android:textColor="#80868B"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 💬 CONVERSATIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 Conversations"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:paddingLeft="16dp"
            android:paddingTop="24dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:id="@+id/liste_vide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="40dp"
            android:gravity="center"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="40sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aucune conversation"
                android:textSize="16sp"
                android:textColor="#5F6368"
                android:layout_marginTop="12dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créez un contact puis envoyez un message"
                android:textSize="13sp"
                android:textColor="#80868B"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ListView
            android:id="@+id/list_conversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:divider="#E8EAED"
            android:dividerHeight="1dp"
            android:paddingTop="4dp"/>

    </LinearLayout>
    <!-- ✅ FIN DU SEUL ENFANT DU ScrollView -->

</ScrollView>
