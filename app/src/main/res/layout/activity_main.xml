<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:id="@+id/barre_haut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Messages"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#202124"/>
            <TextView
                android:id="@+id/badge_cache"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="0"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/badge_cercle"
                android:visibility="gone"/>
        </LinearLayout>

        <EditText
            android:id="@+id/champ_recherche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher des conversations"
            android:background="@drawable/saisie_fond"
            android:padding="10dp"
            android:layout_marginHorizontal="8dp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/list_conversations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/barre_haut"
        android:divider="#E8EAED"
        android:dividerHeight="1dp"
        android:paddingTop="8dp"/>

    <LinearLayout
        android:id="@+id/liste_vide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/barre_haut"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬"
            android:textSize="48sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aucune conversation"
            android:textSize="18sp"
            android:textColor="#5F6368"
            android:layout_marginTop="16dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appuyez sur + pour commencer"
            android:textSize="14sp"
            android:textColor="#80868B"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Boutons en bas à droite -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:spacing="16dp">

        <!-- Bouton Nouveau Contact -->
        <ImageButton
            android:id="@+id/btn_nouveau_contact"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_add"
            android:background="@drawable/fab_background_secondaire"
            android:tint="#FFFFFF"
            android:elevation="4dp"/>

        <!-- Bouton Nouvelle Conversation -->
        <ImageButton
            android:id="@+id/btn_ajouter"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@drawable/fab_background"
            android:tint="#FFFFFF"
            android:elevation="6dp"/>
    </LinearLayout>
</RelativeLayout>
